{
  "name": "kanbun",
  "version": "1.0.0",
  "description": "Real-time Collaborative Kanban Board using B.E.D. Stack (Bun, Elysia, Drizzle)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "lint": "biome lint --max-diagnostics=100 .",
    "lint:apply": "biome lint --apply --max-diagnostics=100 .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write --max-diagnostics=100 .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/bun": "latest",
    "@types/ws": "8.18.1",
    "typescript": "^5.3.0",
    "ws": "8.19.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
