{
  "name": "@kanban/shared",
  "version": "1.0.0",
  "description": "Shared types, schema, and utilities for Kanban BED stack",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./types": "./src/types.ts",
    "./config": "./src/config.ts",
    "./db": "./src/db.ts",
    "./utils/ranking": "./src/utils/ranking.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run migrate.ts",
    "db:seed": "bun run seed.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "better-sqlite3": "12.8.0",
    "drizzle-kit": "0.31.9",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
